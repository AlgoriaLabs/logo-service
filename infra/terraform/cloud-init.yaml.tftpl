#cloud-config
# First boot only: Docker and the app folder. Terraform's deploy step (deploy.tf) installs the compose file, .env
# and the auto-update timer, then starts the containers.
package_update: true
packages:
  - ca-certificates
  - curl
runcmd:
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - mkdir -p /opt/logo-agent
