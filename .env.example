# Stellar Logo Agent configuration. Copy to .env and fill in.
# Public addresses and API keys only. Never put a Stellar secret key (S...) here.
# Comments stay on their own lines: Node and Docker Compose read inline comments differently.

# ── The switch: testnet | mainnet ─────────────────────────────────────────────
NETWORK=testnet

# ── Where it is reachable (https://logo.yourdomain.com in production) ─────────
PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
# Job database (jobs-<network>.sqlite) and generated files
DATA_DIR=./data

# ── Testnet ───────────────────────────────────────────────────────────────────
# Your wallet's G... address with a testnet USDC trustline: `make wallet` sets it up and prints it
PAY_TO_TESTNET=
# The agent id `make register` prints (testnet)
AGENT_ID_TESTNET=
# Optional overrides:
# FACILITATOR_URL_TESTNET=https://x402.org/facilitator
# SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org

# ── Mainnet ───────────────────────────────────────────────────────────────────
# `make wallet NET=mainnet` (the account needs ~3 XLM first)
PAY_TO_MAINNET=
AGENT_ID_MAINNET=
# Free key: https://channels.openzeppelin.com/gen (GitHub sign-in)
FACILITATOR_API_KEY_MAINNET=
# Optional overrides:
# FACILITATOR_URL_MAINNET=https://channels.openzeppelin.com/x402
# SOROBAN_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com

# ── Price: flat, for 1–6 logos ────────────────────────────────────────────────
PRICE_USDC=0.10

# ── Designers: free tiers, tried in this order, then the heuristic designer ───
LLM_PROVIDERS=groq,gemini,openrouter
# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
HEURISTIC_FALLBACK=true

# ── GitHub (optional): raises the API limit from 60 to 5,000 requests/hour ────
# Fine-grained token, "public repositories (read-only)", no extra permissions
GITHUB_TOKEN=

# ── Limits ────────────────────────────────────────────────────────────────────
# How long jobs and their files stay downloadable (seconds, ≥ 3600)
RETENTION_SECONDS=86400
# create-job requests per client per window (0 = off)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Server only (Terraform writes these for you) ──────────────────────────────
# IMAGE=ghcr.io/algorialabs/logo-service
# APP_TAG=main
# TUNNEL_TOKEN=
